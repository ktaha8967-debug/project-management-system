// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  ADMIN
  BDM
  EMPLOYEE
  MANAGER
  INTERN
}

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  fullName        String?
  role            String         @default("EMPLOYEE") // ADMIN, BDM, EMPLOYEE, MANAGER, INTERN
  roleType        String         @default("EMPLOYEE")
  department      String?
  status          String         @default("ACTIVE")
  password        String?
  image           String?
  emailVerified   DateTime?
  projectsCreated Project[]
  tasksAssigned   Task[]         @relation("AssignedTo")
  submissions     Submission[]
  comments        Comment[]
  templates       Template[]     @relation("ApprovedBy")
  leads           Lead[]         @relation("AssignedTo")
  notifications   Notification[]
  team            Team?          @relation(fields: [teamId], references: [id])
  teamId          String?
  timeLogs        TimeLog[]
  badges          UserBadge[]
  points          Int            @default(0)
  accounts        Account[]
  sessions        Session[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Team {
  id         String   @id @default(cuid())
  name       String
  department String
  users      User[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Project {
  id          String      @id @default(cuid())
  name        String
  type        String // PRODUCT, CLIENT, INTERNAL
  description String?
  createdBy   User        @relation(fields: [creatorId], references: [id])
  creatorId   String
  tasks       Task[]
  milestones  Milestone[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Task {
  id               String      @id @default(cuid())
  project          Project     @relation(fields: [projectId], references: [id])
  projectId        String
  title            String
  description      String?
  type             String // NORMAL, EMAIL_TEMPLATE, DEV_TASK, MARKETING
  assignedTo       User        @relation("AssignedTo", fields: [assigneeId], references: [id])
  assigneeId       String
  deadline         DateTime?
  priority         String      @default("MEDIUM") // LOW, MEDIUM, HIGH
  status           String      @default("TODO") // TODO, IN_PROGRESS, SUBMITTED, UNDER_REVIEW, APPROVED, NEEDS_REVISION
  isRecurring      Boolean     @default(false)
  recurrenceType   String? // DAILY, WEEKLY, MONTHLY
  estimatedTime    Int? // in minutes
  delayReason      String?
  dependencyTask   Task?       @relation("TaskDependencies", fields: [dependencyTaskId], references: [id])
  dependencyTaskId String?
  dependentTasks   Task[]      @relation("TaskDependencies")
  submissions      Submission[]
  timeLogs         TimeLog[]
  files            FileAsset[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model TimeLog {
  id        String    @id @default(cuid())
  task      Task      @relation(fields: [taskId], references: [id])
  taskId    String
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  startTime DateTime  @default(now())
  endTime   DateTime?
  totalTime Int? // in seconds
}

model Milestone {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id])
  projectId String
  title     String
  deadline  DateTime
  status    String   @default("PENDING") // PENDING, COMPLETED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SOP {
  id        String   @id @default(cuid())
  title     String
  content   String
  category  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Badge {
  id          String      @id @default(cuid())
  name        String
  description String
  image       String?
  users       UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  badge     Badge    @relation(fields: [badgeId], references: [id])
  badgeId   String
  createdAt DateTime @default(now())
}

model FileAsset {
  id        String   @id @default(cuid())
  task      Task     @relation(fields: [taskId], references: [id])
  taskId    String
  name      String
  url       String
  size      Int
  type      String
  createdAt DateTime @default(now())
}

model Submission {
  id            String    @id @default(cuid())
  task          Task      @relation(fields: [taskId], references: [id])
  taskId        String
  user          User      @relation(fields: [userId], references: [id])
  userId        String
  content       String // HTML/CSS or text
  previewUrl    String?
  versionNumber Int
  status        String    @default("PENDING") // PENDING, UNDER_REVIEW, APPROVED, REVISION_REQUESTED, REJECTED
  comments      Comment[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Comment {
  id           String     @id @default(cuid())
  submission   Submission @relation(fields: [submissionId], references: [id])
  submissionId String
  user         User       @relation(fields: [userId], references: [id])
  userId       String
  content      String
  createdAt    DateTime   @default(now())
}

model Template {
  id         String   @id @default(cuid())
  name       String
  category   String
  htmlCode   String
  previewUrl String?
  status     String   @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, REJECTED
  approvedBy User?    @relation("ApprovedBy", fields: [approverId], references: [id])
  approverId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TemplateLibrary {
  id         String   @id @default(cuid())
  name       String
  category   String
  htmlCode   String
  previewUrl String?
  approvedBy String // Name or ID of approver
  createdAt  DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  title     String
  message   String
  type      String // TASK, REVIEW, COMMENT
  priority  String   @default("NORMAL") // CRITICAL, NORMAL, INFO
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Lead {
  id         String   @id @default(cuid())
  name       String
  email      String
  status     String   @default("NEW") // NEW, CONTACTED, INTERESTED, MEETING_BOOKED, CLOSED
  assignedTo User     @relation("AssignedTo", fields: [assigneeId], references: [id])
  assigneeId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
